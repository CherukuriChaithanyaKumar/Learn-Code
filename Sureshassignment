import java.util.ArrayList;
import java.util.List;

class Subject {
    String subjectName;
    int marks;

    public Subject(String subjectName, int marks) {
        this.subjectName = subjectName;
        this.marks = marks;
    }
}
class Student {
    String studentName;
    int rollNumber;
    List<Subject> subjects;

    public Student(String studentName, int rollNumber, List<Subject> subjects) {
        this.studentName = studentName;
        this.rollNumber = rollNumber;
        this.subjects = subjects;
    }
}
public class Main {
    public static void main(String[] args) {
        List<Student> students = new ArrayList<>();
        students.add(new Student("Chaithanya", 101, List.of(
            new Subject("Maths", 85),
            new Subject("English", 90),
            new Subject("Science", 78)
        )));
        students.add(new Student("Bharath", 102, List.of(
            new Subject("Maths", 70),
            new Subject("English", 88),
            new Subject("Science", 92)
        )));
        students.add(new Student("Chandu", 103, List.of(
            new Subject("Maths", 95),
            new Subject("English", 80),
            new Subject("Science", 85)
        )));

        generateStudentReport(101, students);
    }

    public static void generateStudentReport(int rollNumber, List<Student> students) {
        Student selectedStudent = null;
        for (Student student : students) {
            if (student.rollNumber == rollNumber) {
                selectedStudent = student;
                break;
            }
        }

        if (selectedStudent == null) {
            System.out.println("Not found: " + rollNumber);
            return;
        }

        int totalMarks = 0;
        for (Subject subject : selectedStudent.subjects) {
            totalMarks += subject.marks;
        }
        double percentage = (double) totalMarks / (selectedStudent.subjects.size() * 100) * 100;

        System.out.println("Name: " + selectedStudent.studentName);
        System.out.println("Roll: " + selectedStudent.rollNumber);
        System.out.println("Details:");
        for (Subject subject : selectedStudent.subjects) {
            System.out.println("  " + subject.subjectName + ": " + subject.marks);
        }
        System.out.println("Total: " + totalMarks);
        System.out.printf("Percentage: %.2f%%%n", percentage);
        System.out.println("----------------------");
    }
}
