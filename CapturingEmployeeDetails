import java.io.BufferedWriter;
import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.util.Scanner;

public class EmployeeDetailsCapturing {

    public static void main(String[] args) throws IOException {
        Scanner scanner = new Scanner(System.in);

        System.out.println("Enter employee details:");

        System.out.print("Employee ID: ");
        String empId = scanner.nextLine();

        System.out.print("First Name: ");
        String firstName = scanner.nextLine();

        System.out.print("Last Name: ");
        String lastName = scanner.nextLine();

        System.out.print("Age: ");
        String age = scanner.nextLine();  

        System.out.print("Department: ");
        String department = scanner.nextLine();

        System.out.print("Position: ");
        String position = scanner.nextLine();

        System.out.print("Salary: ");
        String salary = scanner.nextLine();

        String fileName = "employee_data.csv";

        saveEmployeeDetailsToCSV(fileName, empId, firstName, lastName, age, department, position, salary);

        scanner.close();
    }

    public static void saveEmployeeDetailsToCSV(String fileName, String empId, String firstName, String lastName, String age, String department, String position, String salary) throws IOException {
        File file = new File(fileName);
        BufferedWriter writer = new BufferedWriter(new FileWriter(file, true));

        if (file.length() == 0) {
            writer.write("Employee ID,First Name,Last Name,Age,Department,Position,Salary\n");
        }

        writer.write(empId + "," + firstName + "," + lastName + "," + age + "," + department + "," + position + "," + salary + "\n");

        System.out.println("Employee details saved successfully!");

        writer.close();
    }
}
